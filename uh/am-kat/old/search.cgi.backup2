#!/local/bin/perl5

require "intern/lib.pl";
$| = 1;

print "Content-type: text/html\n\n";

%input = &getinput;
$input{maxcout} = 50 unless $input{maxcount};

&noinput if $input{artist} !~ /\S/ && $input{title} !~ /\S/;

&dosearch;

exit 0;


sub noinput {

    &printheader("Ingen avgrensning av søket");

    print <<EOT;

Du må avgrense søket ved å oppgi artist/gruppe og/eller tittel. Gå
tilbake til <a href="search.html">søkeskjemaet</a> og fyll ut igjen
(eller bruk "tilbake-funksjonen" i web-browseren din).

EOT
    &printfooter;
    exit 0;
}


sub dosearch {
    # Søkevariable manipuleres ved enkelt og avansert søk.
    # Tar vare på original i tilfelle vi må gjengi søkeparametre i klartekst
    %originput = %input;
    $originput{category} = "alle kategorier"
	unless length $originput{category};

    open(K, $CATFILE) || &error("Kunne ikke åpne katalogfilen $CATFILE");

    if ($input{method} =~ /^simple/i) {
	$input{title} =~ s/([\W])/\\$1/g;
	$input{artist} =~ s/([\W])/\\$1/g;
    } elsif ($input{method} =~ /^advanced/i) {
	$input{title} =~ s/([^?*\w])/\\$1/g;
	$input{title} =~ s/\?/\\S/g;
	$input{title} =~ s/\*/\\S*/g;
	$input{artist} =~ s/([^?*\w])/\\$1/g;
	$input{artist} =~ s/\?/\\S/g;
	$input{artist} =~ s/\*/\\S*/g;
    } else {
	eval("/$input{artist}/");
	$feil = $@;
	$feil .= "<br>\n" if length $feil;
	eval("/$input{title}/");
	$feil .= $@;
	$feil =~ s/at \(eval.+\) line 1.//g;
	if ($feil) {
	    &printheader("Feil i regulært uttrykk");
	    print <<EOT;

Du har forsøkt å gjøre et ekspertsøk men har angitt ulovlig regulært
uttrykk. Se beskrvielsen av hvordan man gjør <a
href="searchinfo.html#expert">ekspertsøk</a> dersom du er usikker
på hva som er lovlige søkeuttrykk. Rett opp feilene i <a
href="search.html">søkeskjemaet</a> eller velg <a
href="searchinfo.html#simple">enkelt søk</a>.<p>

Nærmere beskrivelse av feilen:
<blockquote><font size="+1">
<b>$feil</b>
</blockquote>
EOT
            &printfooter;
	    &log(-1);
	    exit 0;
        }
    }

    $primary = &selectprimary;

    # Bug i Mosaic m.fl(?): klarer ikke å sende med select/option med 
    # value="" selv om man eksplisitt har bedt om det. Fix for dette:
    $input{category} = "" if $input{category} =~ /^alle kategorier/i;

    $cat = (length $input{category}) ? 
	lc "kategori: $input{category}" : "alle kategorier";

    &printheader("Søkeresultat, $cat");

    if ($input{subtext} =~ /^no/i) {
	$input{title} = "\\b$input{title}\\b"
	    if length $input{title};
	$input{artist} = "\\b$input{artist}\\b"
	    if length $input{artist};
    }

    $code = " while (<K>) { push(\@candidate, \$_) if ( $primary ); }";
#    print "<pre>$primary\n";
#    print "$code</pre>\n";
    eval($code);

    foreach (@candidate) {
	@f{@FIELDS} = split(/;/);
	if ($f{category} eq "DIV. KLASSISK") {
	    $tmp = $f{title};
	    $f{title} = $f{recording};
	    $f{recording} = $f{artist};
	    $f{artist} = $tmp;
	}
	next if length $input{title} &&
	    $f{title} !~ /$input{title}/io;
	
	next if length $input{artist} &&
	    $f{artist} !~ /$input{artist}/io;
	
	next if length $input{category} &&
	    $f{category} !~ /^$input{category}$/io;
	
	$f{recording} = ", ".$f{recording} if $f{recording} =~/\S/;
	
	$counter++;
	last if $counter > $input{maxcount};

	$f{year} = "" unless $f{year};
	$f{title} = "[produktinfo]" unless length $f{title};

	push(@matches, join(";", @f{@FIELDS}));
	push(@sortkeys, lc join(" ", @f{'category', 'artist', 'title'}));
    }

    sub myway { $sortkeys[$a] cmp $sortkeys[$b]; }
    @matches = @matches[sort myway $[ .. $#matches];
    
    foreach (@matches) {
	@f{@FIELDS} = split(/;/);
	if (!length $input{category} && $lastcat ne $f{category}) {
	    $lastcat = $f{category};
	    $list .= qq!<tr>\n<td colspan="3" align="center">!;
	    $list .= qq!<font size="+1">!;
	    $list .= qq!<b><em>$lastcat</em></b></font><br></td>\n!;
	}
	$f{price} =~ s/,(\d\d)\d+/.$1/;
	$list .= qq!<tr>\n!;
	$list .= qq!<td valign="top"> &#160;$f{artist}</td>\n!;
	$list .= qq!<td valign="top"> &#160;<a href="showitem.cgi?no=$f{no}">!;
	$list .= qq!$f{title}</a>$f{recording}</td>\n!;
	$list .= qq!<td valign="top" align="right" width="80">$f{price}&#160;<br></td>\n!;
    }

    if ($counter > 0) {
	if ($counter > $input{maxcount}) {
	    print "<em>Søket ble avbrutt etter $input{maxcount} treff.</em><p>\n";
	} else {
	    print "<em>Tilsammen $counter titler i listen nedenfor.<p></em>\n";
	}
	print <<EOT;
<table border="1" cellpadding="0">
<tr>
<td width="250"><font size="+2">&#160;Artist/gruppe</font></td>
<td width="150"><font size="+2">&#160;Tittel</font></td>
<td align="center"><font size="+2">Pris</font><br></td>

$list
</table><p>
EOT
    } else {
	print "<h2>Søket ga ingen treff</h2>\n";
	print "<p>Søkeparametrene var som følger:\n<ul>";
	foreach (sort keys %input) {
	    next unless length $originput{$_};
	    print "<dt> <b>$_</b>\n<dd> $originput{$_}\n";
	}
	print "</dl>\n";
    }
    &log($counter);
    &printfooter;
}


sub selectprimary {
    if (length $input{artist} > length $input{title}) {
	$key = $input{artist} . "&" . $input{title};
    } else {
	$key = $input{title} . "&" . $input{artist};
    }
    $key =~ s/^\&|\&$//;

    $key =~ s/([|&])/$1$1/g;
    $key =~ s,([^()|&]+), /$1/i ,g;
    return $key;
}


sub log {
    local($count) = $_[0];

    open(L, ">>$SEARCHLOG") || return;
    @f = localtime(time);
    $dato = sprintf("%02d%02d%02d %02d:%02d:%02d",
		    $f[5], $f[4]+1, $f[3], @f[2,1,0]);
    $maskin = $ENV{REMOTE_HOST} || $ENV{REMOTE_ADDR};

    print L "$count;$input{maxcount};";
    print L "$originput{artist};$originput{title};$originput{category};";
    print L "$originput{method};$originput{subtext};$dato;$maskin\n";
    close L;

}
