#!/local/bin/perl5 -w

# Split the convention.html file into individual parts

open(C, "convention.html") or die "Can't open: $!";

mkdir("convention", 0755);

open(F, ">/dev/null");

while (<C>) {
    if (/name="(\d+)/) {
       $lastno = $1;
       open_file($1);
       s,</?a[^>]*>,,g;
       s,h3>,h2>,g;
    }
    print F $_;
}
open_file($lastno+1);


sub open_file
{
    my($no) = @_;
    print F <<"EOF";
<hr>
[ 
EOF
 
 for (1..54) {
     print F qq{<a href="art$_.html">$_</a>\n} if $_ != $no - 1;
 }

 print F qq{\n]\n<br>[ <a href="/Childwatch/convention.html">The complete convention</a> ]\n</body>\n};
close(F);
    open(F, ">convention/art$no.html") or die "Can't open: $!";
    print F <<"EOF";
<head>
  <title>Convention on the Rights of the Child</title>
</head>

<body>

<h1 align=center>Convention on<br>the Rights of the Child</h1>
EOF
}
