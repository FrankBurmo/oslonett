\par 
\par \pard \fi-1440\li1584\ri142\tx-720\tx0\tx720 10.1\tab \tab Partene er enige om \'e5 anbefale vedlagte for\-slag til standardavtale anvendt ved avtale om almen\-praksis i kommunene.
\par \pard \li144\ri142\tx-720 
