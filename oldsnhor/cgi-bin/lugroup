#!/local/bin/perl -w

print "Content-type: text/html

";

$LUGROUP = "/local/bin/lugroup";

$| = 1;

print "<html><head>\n<title>Lookup newsgroups at SN Internet</title></head>\n<body background=\"/gifs/on/onbg.gif\">\n<isindex prompt=\"Type in keyword (new search) : \">\n";

@arg = split(/\+/, $ENV{QUERY_STRING});

foreach (@arg) {
   s/%([\da-f]{1,2})/pack(C,hex($1))/eig;
}
@arg = grep(!/^\s*$/, @arg);  # remove empty arguments
unless (@arg) {
    print "<h2>No search string specified!</h2>\n";
    &trailer;
    exit;
}

open(STDOUT, "|-") || do { &formater; &trailer; exit };

close(STDERR);
exec $LUGROUP, @arg;
exit;

sub formater
{
    $groups = 0;
    $count = 0;
    @nothere = ();
    @moderated = ();
    @readonly = ();
    print "<h2>";
    while (<STDIN>) {
	if (/^=====/) {
	    next; #print "<hr>\n";
	} elsif (/^---/) {
	    $groups = 1;
	    print "</h2>\n<dl>\n";
	    next;
        } elsif (/^\(a leading/) {
            print ".";
	    next;
        } elsif (/^ a \"\+\" that/) {
	    next;
	} else {
	    if ($groups) {
		($present, $group, $text) = m/^([-+= ])(\S+)\s+(.*)/;
		if (defined $group && $present ne "-") {
		    print qq{<dt><a href="news:$group"><b>$group</b></a><dd>$text\n};
		    $count++;
		}
		if ($present eq "-") {
		    push(@nothere, "$group:$text");
		} elsif ($present eq "+") {
		    push(@moderated, "$group:$text");
		} elsif ($present eq "=") {
		    push(@readonly, "$group:$text");
		}
	    } else {
		print;
	    }
	}
    }
    print "</dl>\n";
    unless ($count) {
	print "None found!\n";
    }
    if (@moderated) {
	print "<h2>Moderated newsgroups available at SN Internet</h2>\n";
	print "<dl>\n";
	foreach (@moderated) {
            ($group,$text) = split(/:/, $_);
	    print qq{<dt><a href="news:$group"><b>$group</b></a><dd>$text\n};
	}
	print "</dl>\n";
    }
    if (@readonly) {
	print "<h2>Read only newsgroups available at SN Internet</h2>\n";
	print "<dl>\n";
	foreach (@readonly) {
            ($group,$text) = split(/:/, $_);
	    print qq{<dt><a href="news:$group"><b>$group</b></a><dd>$text\n};
	}
	print "</dl>\n";
    }
    if (@nothere) {
	print "<h2>Newsgroups not available at SN Internet</h2>\n";
	print "<dl>\n";
	foreach (@nothere) {
            ($group,$text) = split(/:/, $_);
	    print qq{<dt><b>$group</b></a><dd>$text\n};
	}
	print "</dl>\n";
    }
}

&trailer;

