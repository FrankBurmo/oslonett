#!/local/bin/perl5 
#
# CGI-script som oversender varebestilling pr. mail. Faste felter:
# 	mailto		mottaker for mail
#	reply-to	hvor evt. svar på tilsendt mail skal sendes
#	subject		ønsket tittel i utsendt mail
#
# Alle feltnavn som avsluttes med sifre organiseres i en tabell der sifrene
# angir hvilken linje feltet skal inn i og feltnavnet uten sifre angir 
# kolonnen. Feltnavnene i linje 1 definerer rekkefølgen av kolonnene og
# hvilke kolonner som skal tas med for etterfølgende linjer. To kolonner
# er obligatoriske: "Antall" og "Enhetspris". Et kolonnenavn er reservert:
# "Pris". Dette feltet beregnes automatisk, eventuelle medsendte data blir
# overskrevet. Kolonnene Antall og Pris summeres for alle bestilte produkter,
# og det legges til MVA til kolonnen Pris. Dersom man ikke ønsker tillagt
# MVA, sender man med et felt med navn IkkeMVA som har en ikke-null verdi
# Feltnavn er case sensitive.

$mva		= 23;	# 23% mva
$excltext	= "Sum:";
$mvatext	= "+ $mva% mva:";
$incltext	= "Pris inkl. mva:";
$replyaddr	= "kgn\@oslonett.no"; # while testing
$defaultsubj	= "[Automatisk videresendt web-bestilling]";

print "Content-type: text/html\n\n";

%input = &getinput;

$input{'reply-to'} = $replyaddr unless $input{'reply-to'};
$input{subject} = $defaultsubj unless $input{subject};

$bodyattr = " $input{bodyattr}";
$imgattr = "<img $input{imgattr}>" if $input{imgattr};
delete($input{bodyattr});
delete($input{imgattr});

&assert;

&preparedata;

open(MAIL, "| /usr/lib/sendmail -t")
    || &error("Feil i CGI-script: kunne ikke starte sendmail");
print MAIL "To: $input{mailto}\nSubject: $input{subject}\n";
print MAIL "Reply-To: $input{'reply-to'}\n" if $input{'reply-to'};
print MAIL "Automatisk sendt bestilling via $0:\n\n";

&maketable("MAIL", "plain");

print MAIL "\nInformasjon fra avsender:\n\n";
foreach (@datanames) {
    next if /^mailto$|^subject$|^reply-to$|^rcpturl$/;
    next unless $input{$_} =~ /\S/;
    $input{$_} =~ s/^\.$/. /;	# "\n.\n" must not end mail msg. being composed
    printf MAIL "%20s : %s\n", $_, $input{$_};
}
printf MAIL "%20s : %s\n", "Sendt fra maskin", $ENV{REMOTE_HOST};
printf MAIL "%20s : %s\n", "Aksessert fra", $ENV{HTTP_REFERER};
print MAIL "\n\n ---\n\n";
print MAIL "Henvendelser angående denne tjenesten rettes til $replyaddr\n";
print MAIL "\n.\n";
close (MAIL);

&printheader("Kvittering");

print "Vi har mottatt følgende bestilling fra deg:<p>\n";

print "<pre>\n";
&maketable("STDOUT", "html");
print "</pre>";

print "<p>\n<dl>\n";
foreach (@datanames) {
    next if /^mailto$|^subject$|^reply-to$|^rcpturl$/;
    next unless $input{$_} =~ /\S/;
    print " <dt> <b>$_</b>\n <dd> $input{$_}\n" if length $input{$_};
}
print " <dt> <b>Sendt fra maskin</b>\n <dd> $ENV{REMOTE_HOST}\n";
print " <dt> <b>Aksessert via</b>\n <dd> $ENV{HTTP_REFERER}\n";
print "</dl>\n";
print "Denne informasjonen er elektronisk oversendt til $input{mailto}\n";
&printfooter;

exit 0;


sub assert {
# Return error message if
#	- wrong CONTENT_TYPE
#	- access from HTML document not within oslonett.no domain
#	- no "mailto" input field indicated (no one to send mail to)

    &error("Dette programmet kan kun dekode input fra HTML FORMS")
	unless $ENV{CONTENT_TYPE} eq "application/x-www-form-urlencoded";

    &error("Programmet kan kun brukes fra HTML-filer som ligger på Oslonetts " .
	   "web-servere</h2>Programmet ble aksessert via $ENV{HTTP_REFERER}")
	unless $ENV{HTTP_REFERER} =~  (/oslonett\.no/ || /sn\.no/);
    &error("Ingen mottakeradresse medsendt (feil i HTML FORM)")
	unless  length $input{mailto};
}



sub preparedata {
# Builds %sum, %width, %data, %lines, %justify, %decimals, @columnnames.
# These arrays are used to format the table of orders

    local($colname, $lineno, $len);

    foreach (@datanames) {
	next unless ( /^(\D+)(\d+)$/ );
	($colname, $lineno) = ($1, $2);
	push(@columnnames, $colname) if $lineno == 1;
	$colname = $colname;
	$len = length $input{$_};
	$len = length $1 if ($colname =~ /^Enhetspris$|^Antall$/ && 
			     $input{$_} =~ /(\d+)\./ );
	$len += 3 if ( $colname =~ /^Enhetspris$/ );
	$width{$colname} = $len if $len > $width{$colname};
	$data{$_} = $input{$_};
	$lines{$lineno} = 1;
	delete $input{$_};     # %input should not contain any fields in %data
	$sum{$colname} += $data{"$colname$lineno"} if $colname eq "Antall";
    }

    push(@columnnames, "Pris");
    foreach $lineno (sort keys %lines) {
	$data{"Pris$lineno"} =
	    $data{"Antall$lineno"} * $data{"Enhetspris$lineno"};
	$sum{Pris} += $data{"Pris$lineno"};
    }
    $width{Pris} = $width{Antall} + $width{Enhetspris};

    foreach (@columnnames) {
	$width{$_} = length($_) if length($_) > $width{$_};
	$justify{$_} = "<";
	if ($_ eq "Enhetspris" || $_ eq "Pris") {
	    $justify{$_} = ">";
	    $decimals{$_} = 2;
	}
	if ($_ eq "Antall") {
	    $justify{$_} = ">";
	    $decimals{$_} = 0;
	}
    }

# keys(%line) indicates which lines have any defined column entries
# $width{colname} holds length of longest column entry, including column header
# data entries are stored in %data

    $len = 0;
    foreach ($excltext, $mvatext, $incltext) {
	$len = length($_) if length($_) > $len;
    }

    $width{$columnnames[0]} = $len
	if $len > $width{@columnnames[0]};

  LINE:
    foreach $lineno (keys %lines) {
      COL:
	foreach $colname (@columnnames) {
	    next LINE if $data{"$colname$lineno"}; 
	}
	delete($lines{$lineno});	# discard empty lines
    }
}



sub maketable {
# writes a table of ordered products to filehandle indicated by the first
# parameter. Second parameter should be "plain" or "html" indicating output
# format of table.
    local($fh, $formatting) = @_;
    local($format);

    $ruler = ($formatting =~ /html/i) ? "<hr>" : "-" x 75 . "\n";

    if (! %lines) {
	print $fh "$ruler   Ingen bestilling registrert!\n$ruler\n";
	return;
    }

    $format = "format $fh =\n$preline";
    foreach (@columnnames) {
	$format .= "@" . $justify{$_} x $width{$_} . "   ";
    }

    $format .= "$postline\n" . 'shift @col,' x @columnnames;
    chop($format);		# remove last comma
    $format .= "\n.\n";
    eval($format);

    # write header
    @col = @columnnames;
    write $fh;

    print $fh $ruler;

    # write table
    foreach $lineno (sort keys %lines) {
	$data{"Pris$lineno"} =
	    $data{"Antall$lineno"} * $data{"Enhetspris$lineno"};
	@col = ();
	foreach $colname ( @columnnames ) {
	    if (defined($decimals{$colname})) {
		push(@col, sprintf("%0.$decimals{$colname}f",
				   $data{$colname . $lineno}));
	    } else {
		push(@col, $data{$colname . $lineno});
	    }
	}
	write $fh;
    }
    print $fh $ruler;

    # write sum
    @col = ();
    foreach (@columnnames) {
	push(@col, (! defined($sum{$_})) ? "" :
	     sprintf("%0.$decimals{$_}f", $sum{$_}));
    }
    if (! length $col[0]) {
	$col[0] = $excltext;
    } else {
	print $excltext;
    }
    write $fh;

    if (! defined($input{IkkeMVA}) ) {
	# write tax
	@col = ();
	foreach (@columnnames) {
	    push(@col, ($_ ne "Pris" ) ? "" :
		 sprintf("%0.$decimals{$_}f", $sum{$_} * $mva / 100));
	    push(@nextcol, ($_ ne "Pris" ) ? "" :
		 sprintf("%0.$decimals{$_}f", $sum{$_} * (100 + $mva) / 100));
	}
	if (! length $col[0]) {
	    $col[0] = $mvatext;
	    write $fh;
	    $nextcol[0] = $incltext;
	    @col = @nextcol;
	    write $fh;
	} else {
	    print $mvatext;
	    write $fh;
	    print $incltext;
	    @col = @nextcol;
	    write $fh;
	}
    }
}



sub getinput {
# Return %input array, associating input names with input values
# Also builds global array @datanames, giving original order of input
# field names.
    local($i, $name, $value, $data, @data, %input);

    if ($ENV{'REQUEST_METHOD'} eq "GET") {
        $data = $ENV{'QUERY_STRING'};
    } elsif ($ENV{'REQUEST_METHOD'} eq "POST") {
        read(STDIN, $data, $ENV{'CONTENT_LENGTH'});
    } else {
        return;
    }

    # Del opp input-data i felter ved alle forekomster av '&'.
    @data = split(/&/, $data);

    for $i (0 .. $#data) {

        # Pluss oversettes til SPC
        $data[$i] =~ tr/+/ /;

        # Alt til venstre for første "=" er feltnavn, resten er felt-verdi
        ($name, $value) = split(/=/, $data[$i], 2);

        # Erstatt forekomster av %<hexkode> med tilsvarende tegn
        $name =~ s/%(..)/pack("c",hex($1))/ge;
        $value =~ s/%(..)/pack("c",hex($1))/ge;

	$value =~ s/\s+/ /g;
	push(@datanames, $name);
	$input{$name} = $value;
    }
    %input;                     # returnerer den assosiative array'en
}


sub error {
# returns HTML error message and exits program
    local($msg) = $_[0];

    &printheader("Feilmelding");
    print "<h2>$msg</h2>";
    print "Eventuelle spørsmål kan rettes til ";
    print "<a href=\"mailto:$replyaddr\">$replyaddr</a>.";
    &printfooter;
    exit 1;
}


sub printheader {
    local($head) = $_[0];
    local($img);
    $img = "<img $input{imgattr}>" if $input{imgattr};

    print "<html>\n<head>\n <title>$head</title>\n";
    print qq{ <link rev="made" href="mailto: $replyaddr"></head>\n};
    print "<body $bodyattr>\n$imgattr<h1>$head</h1>\n\n";
}


sub printfooter {
    print qq{\n<hr>\n<a href="http://www.oslonett.no/">\n};
    print qq{  <img border="0" alt="[Oslonett Home]" src="/gifs/on/oslonett-i.gif"></a>\n};
    print "</body>\n</html>\n";
}

