#!/usr/bin/perl
#
# graph-log -- print out usage histogram
#
# graph-log-week,v 2.1 1993/06/29 02:40:33 sanders Exp
#
$log = $ARGV[0] || "/usr/local/www/log.summary";

$req = 0;
$same_day = 1;

open(LOG, $log) || die "$log: $!";
while(<LOG>) {
    next if /^-/;
    @data = split(" ");
    $req++;
    next if ($same_day && $data[1] eq "Mon");
    $same_day = 0;

    $data[1] eq "Mon" && do {
	print "*" x ($req/100), "\n";		# histogram
	$req = 0;
	$same_day = 1;
    };
}
print "*" x ($req/100), "\t\t\t-- short\n";	# histogram
close(LOG);

