#!/usr/bin/perl
#
# graph-log -- print out usage histogram
#
# graph-log,v 2.1 1993/06/29 02:40:31 sanders Exp
#
$log = $ARGV[0] || "/usr/local/www/log.summary";

$req = 0;
$same_day = 1;
undef $day;

open(LOG, $log) || die "$log: $!";
while(<LOG>) {
    next if /^-/;
    @data = split(" ");
	$day = $data[1] unless defined $day;	# once only
    $req++;
    next if ($same_day && $data[1] eq $day);
    $same_day = 0;
    $day = $data[1];		# XXX

    do {
	print "*" x ($req/10), "\n";		# histogram
	$req = 0;
	$same_day = 1;
    };
}
print "*" x ($req/10), "\t\t\t-- short\n";	# histogram
close(LOG);

