#!/bin/sh
#
# summary -- summerize usage log
#
# summary,v 2.7 1994/11/06 20:47:31 sanders Exp
#

PATH="$PATH:/usr/contrib/bin"
cd /usr/local/www

bin/usage.byhost
bin/usage.byurl
mv log log-; touch log; bin/plexus-restart
echo ------- SUMMARY ------- >> log.summary
cat log- >> log.summary

rm -f log- usage.host- usage.url-
