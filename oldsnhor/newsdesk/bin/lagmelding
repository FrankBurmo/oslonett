#!/local/bin/perl5 -w

%auth		= (
		   'barde@sn.no',     	1,
		   'barde@a.sn.no',     	1,
		   'steinar@sn.no',     	1,
		   'steinar@mail.sn.no',     	1,
		   'steinar@a.sn.no',   	1,
		   'cfeen@a.sn.no',		1,
		   'cfeen@sn.no',		1,
		   'oddstad@a.sn.no',   	1,
		   'steingl@a.sn.no',   	1,
		   'oddstad@sn.no',      	1,
		   'mortensl@a.sn.no',		1,
		   'mortensl@sn.no',		1,
		   'knutf@a.sn.no',		1,
		   'knutf@sn.no',		1,
		   'kentv@a.sn.no',		1,
		   'mariann@a.sn.no',		1,
		   'arneom@a.sn.no',		1,
		   'dagwi@a.sn.no',		1,
		   'dagwi@sn.no',		1,
		   'eflaten@a.sn.no',		1,
		   'eflaten@sn.no',		1,
		   'kgn@a.sn.no',		1, # while testing
		   );

@ignoreaddr	= (
		   'webdesk@oslonett.no',
		   'webdesk@sn.no',
		   '(?i)mailer-daemon',
		   );

$replyaddr	= 'webmaster@sn.no';

$top		= "/local/www/newsdesk";

$linkfile	= "$top/lib/linker";
$headerfile	= "$top/lib/HEADER";
$footerfile	= "$top/lib/FOOTER";
$htmldir	= "$top/html";
$admdir		= "/local/etc/www/admin";

$htmlurl	= "http://www.sn.no/newsdesk/html";
$previcon	= "http://www.sn.no/gifs/on/arrows/prev.gif";
$upicon		= "http://www.sn.no/gifs/on/arrows/up.gif";
$nexticon	= "http://www.sn.no/gifs/on/arrows/next.gif";

@month		= qw(Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec);
@mnd		= qw(januar februar mars april mai juni juli
		     august september oktober november desember);

umask 002;

$header = &readfile($headerfile) ||
    "<html>\n<head><title>SUBJECT</title></head>\n" .
    "<body>\n<h1>SUBJECT</h1>\n";
$footer = &readfile($footerfile);

%header = &getheaders;
$/ = undef;

$body = <>;

if (lc($header{'content-transfer-encoding'}) eq 'quoted-printable' ||
    lc$header{'subject'} =~ /=\?iso-8859-1\?Q\?/ ) {
    $header{'subject'} =~ s/\?=//g;
    $header{'subject'} =~ tr/_/ /;
    $header{'subject'} =~ s/=\?iso-8859-1\?Q\?//;
    $header{'subject'} =~ s/=([0-9a-fA-F]{2})/pack("c", hex($1))/ge;
    $body =~ s/=\n//g;
    $body =~ s/=([0-9a-fA-F]{2})/pack("c", hex($1))/ge;
}

($sender) = ( $header{'from'} =~ /\b([\w\.-]+\@[\w\.]+)\b/ );

# Exit quietly if no $sender (no-one to reply to)
exit 0 unless $sender;

($yy, $mm, $dd) = &assert(%header);
($sec, $min, $hour, $mday, $mon, $year, $wday, $yday)
    = localtime;
$compactdate = sprintf("%02d%02d%02d", $yy, $mm+1, $dd);
$date = sprintf("%d. %s %d, kl. %2.2d:%2.2d", $dd, $mnd[$mm], $yy+1900,$hour, $min);

opendir(DIR, $htmldir) || &error("Kunne ikke gjøre cd til $htmldir");
@files = grep( /^\d{6}-\d{2}.html$/ , sort readdir(DIR));
close(DIR);
# @files contains all filenames of press releases (format yymmdd-nn.html)

$nn = 0;
foreach (@files) {
    $nn = $1 if ( /^$compactdate-(\d\d)/ && $1 > $nn);
}
# $nn is now the number of the last message the same
# day, or  0 if this is the first message.

&error("For mange artikler registrert under $compactdate (maks 100)")
    if ($nn >= 99);

$thisfile = sprintf("%s-%02d.html", $compactdate, ++$nn);
$lastfile = $files[$#files] if (@files);

@usedlinks = &writehtmlfile($thisfile, $lastfile, $date, %header);

&updateindex($thisfile, $date);

&updatelastfile($thisfile, $lastfile) if ($lastfile);

# update wais index here

system("/local/bin/waisindex -l 1 -a -d $top/wais/SN-wdesk -t URL $top/html http://www.sn.no/newsdesk/html $htmldir/$thisfile > /dev/null 2>&1 ");

&feedback($thisfile, @usedlinks);

exit 0;



sub getheaders {
    local($lastref);
    local(%header);

    while (<>) {
	chop;
	last if /^$/;
	if (/^(\S+?):\s*(.*)/) {
	    $header{lc $1} = $2;
	    $lastref = \ $header{lc $1};
	} elsif (/^\s/) {		# continued line
	    $$lastref .= $_;
	}
    }
    return %header;
}



sub assert {
    local(%header) = @_;
    local($date, $yy, $mm, $dd);

# Some senders are ignored (esp. the script itself). Do not reply!
    foreach (@ignoreaddr) {
	exit 0 if ( $sender =~ /$_/ );
    }

    &unauthorized($sender) unless $auth{$sender};
    &notitle unless $header{subject};

# Get date from X-Date or Date. Both in RFC822 date format
    $date = $header{'x-date'} || $header{date};
    &illegaldate($date)
	unless
	    ( ($dd, $mon, $yy) = 
	     ($date =~ /^(?:\w{3},?) (\d\d?) (\w{3}) (\d\d(?:\d\d)?) \d\d:\d\d/));

    $yy -= 1900 if $yy>=1900;
    $mm = 0; 
    while ($mon ne $month[$mm]) { $mm++; }
    &illegaldate($date) unless ( $mm < 12 );

    return ($yy, $mm, $dd);
}


sub notitle {
    &mailmsg("Kan ikke sende ut artikkel, tittel mangler",
	     "
Du har sendt inn en artikkel som ikke kan sendes ut fordi den
ikke har fått noen tittel. Artikkelens tittel fylles ut i
brevets Subject-header. Forsøk igjen. Den opprinnelige meldingen 
er vedlagt nedenfor:

----------
$body
");
    exit 0;
}


sub writehtmlfile {
    local($thisfile, $lastfile, $date, %header) = @_;
    local($navigate, @linkwords, $key, $val, %words);

    $navigate = "<!-- ENDBODY-->\n" .
	qq{<a href="$htmlurl/$lastfile">} .
	    qq{<img alt="[Forrige]" border="0" src="$previcon" align="absmiddle"></a>\n} 
    if ($lastfile);
    $navigate .= 
	qq#<a href="$htmlurl/index.html">\n# .
	    qq#  <img alt="[Indeks]" src="$upicon" border="0" align="absmiddle"></a>\n# .
		qq#<!-- Neste linje må ikke fjernes, den brukes ved # .
		    qq#automatisk oppdatering -->\n# .
			qq#<!-- NEXTREFERENCE -->\n#;

    local($/) = undef;
    $body =~ s#\n\s*\n#\n<p>\n\n#g;

# Ønsker at <x-literal>..</x-literal> i innsendt kode skal escape's slik at 
# all HTML-kode vises som source. Dvs. vi må kode de fire tegnene & < > " 
# som entities:
    $body =~ s:<x-literal>([\s\S]+?)</x-literal>:
	($b=$1) =~ s/&/&amp;/g,
        $b=~s/&/&amp;/g,
        $b=~s/</&lt;/g,
        $b=~s/>/&gt;/g,
        $b=~s/\"/&quot;/g,
        sprintf "<pre>$b</pre>";:gie;

## AUTO URL linking
    $body =~ s/<URL:(\S+)>/$1/g;

# Kommenterte bort neste linje etter forespørsel fra Erland. 8.2.96 kgn
#    $body =~ s%((http|ftp|gopher)://(\S+[\w/]))(\.?[\s,<])%<a href=$1>$1</a>$4%gi;


#    %words = &init_words;
#    while ( ($key, $val) = each %words) {
#	($keycopy = $key) =~ s/ /\\s+/g;
#	push(@linkwords, $key) if ($body =~ s/$keycopy/$val/);
#    }
#    $body .= "<p><em><a href=mailto:$sender>$sender</a></em>\n";
    $header =~ s/SUBJECT/$header{'subject'}/ig;
    $footer =~ s/NAVIGATE/$navigate/i;
    open(FILE, ">$htmldir/$thisfile")
	|| &error("Kunne ikke åpne ny HTML-fil ($htmldir/$thisfile)");
    print FILE "$header\n";
    print FILE "<!-- Filen er automatisk generert av $0 -->\n\n";

    print FILE "<em>Oslo, $date</em>\n<p>\n\n";
    print FILE $body;
    print FILE $footer;
    print FILE "</body>\n</html>\n";
    close FILE;
    return @linkwords;
}


sub init_words {
    local(%word);
    local($/) = "\n";
    open (WORDS, "$linkfile") || return undef;
    while (<WORDS>) {
	next if /^#/ || /^$/;
        chop;
        /(.*)%(.*)/;
        $word{$1} = $2;
    }
    close (WORDS);
    return %word;
}


sub updateindex {
    local($thisfile, $date) = @_;
    local($index);

    $index = &readfile("$htmldir/index.html");
    $index =~ s#(<!--\s*NEXT\s*REFERENCE\s*-->)#$1
	<dt> $date\n         <dd> <a href="$htmlurl/$thisfile">$header{subject}</a>#i;

    open(IDX, ">$htmldir/index.html") 
	|| &error("Kunne ikke oppdatere indeks-filen ($htmldir/index.html).");
    print IDX $index;
    close IDX;

   $index = &readfile("$admdir/edit.html");
    $index =~ s#(<!--\s*NEXT\s*REFERENCE\s*-->)#$1
	<dt> $date [ <a href="/admin/edit.cgi?file=$thisfile&op=del">Slett</a> | <a href="/admin/edit.cgi?file=$thisfile&op=edit">Editer</a> | <a href="/admin/edit.cgi?file=$thisfile&op=ark">Arkiver</a> ]\n        <dd> <a href="$htmlurl/$thisfile">$header{subject}</a>#i;

    open(IDX, ">$admdir/edit.html") 
	|| &error("Kunne ikke oppdatere edit-filen ($admdir/edit.html).");
    print IDX $index;
    close IDX;
}


sub updatelastfile {
    local($thisfile, $lastfile) = @_;
    local($navigate, $last);

    $navigate =
	qq{<a href="$htmlurl/$thisfile">} .
	    qq{<img alt="[Neste]" border=0 src="$nexticon" align="absmiddle"></a>\n};

    $last = &readfile("$htmldir/$lastfile");
    $last =~ s#(<!--\s*NEXT\s*REFERENCE\s*-->)#$1\n$navigate#i;
    open(FILE, ">$htmldir/$files[$#files]")
	|| &error("Kunne ikke oppdatere forrige fil ($htmldir/$lastfile).");
    print FILE $last;
    close FILE;
}



sub feedback {
    local($file, @usedlinks) = @_;
    local($msg);

    $msg = "Denne meldingen er automatisk generert.\n\n" .
	"Den innsendte artikkelen er nå lagt ut under SN Horisonts " .
	"websider.\nURL til artikkelen er:\n\n\t$htmlurl/$file\n\n";

    $links = join(", ", sort @usedlinks);
    if ($links) {
	$msg .= "Følgende ord i meldingen er brukt som ankere for " .
	    "hypertekst-linker\n\n";
	while (length $links) {
	    if ($links =~ s/^(.{50,75},\s)//) {
		$msg .= "    $1\n";
	    } else {
		$msg .= "    $links\n";
		last;
	    }
	}
    }
    $msg .= "\nDersom meldingen skal endres, kan man editere filen

	$htmldir/$file

Husk å oppdatere filen 'index.html' på samt (evt.) forrige og neste
fil dersom en artikkel skal fjernes. Det er også mulig å editere filen
via URL 

        http://www.sn.no/admin/edit.html
";

    mailmsg("Har lagt ut ny artikkel fra Web desken", $msg);
}



sub readfile {
    local($name) = $_[0];
    local($/) = undef;
    local($contents);

    open(FILE, $name) || return undef;
    $contents = <FILE>;
    close FILE;
    return $contents;
}



sub unauthorized {
    local($sender) = $_[0];

    if ($sender =~ /\.no$/) {	# Send reply in norwegian when domain .no

	&mailmsg("Du er ikke autorisert til å sende ut artikler for Web desken", 
		 "
Denne meldingen er generert automatisk.

Du har sendt mail til 'webdesk\@www.sn.no'. Dette er en mailadresse
for automatisk utsending av artikler. Du er ikke autorisert til
å benytte denne tjenesten.

Dersom du mener du skulle hatt anledning til å benytte tjenesten eller
om du ønsker mer informasjon, ta kontakt med $replyaddr.

");

    } else {			# Send reply in english otherwise

	&mailmsg("You are not authorized to issue press releases for Schibsted Nett AS", 
		 "
This message is sent automatically.

You have sent mail e-mail to 'webdesk\@www.sn.no'. This is a mail
alias to issue press releases automatically. You are not authorized to
use this service.

Contact $replyaddr for further information.

");

    }

    exit 0;
}



sub illegaldate {
    local($date) = @_;

    &mailmsg("Ulovlig datoformat sendt til artikkel-adressen", "

Denne meldingen er generert automatisk.

Du har sendt mail til Schibsted Netts adresse for automatisk utsending av
artikler. Den medsendte datoen

	$date

er imidlertid ikke på lovlig RFC-822-format. Formatet skal være som følger:

	[DDD,] d[d] MMM yy[yy] hh:mm[:ss] ZZZ

der
 - DDD     er ukedag (kan utelates), en av... Sun Mon Tue Wed Thu Fri Sat
 - d[d]    er datoen, ett eller to siffer
 - MMM     er måneden, en av... @month
 - yy[yy]     er årstallet, to eller fire siffer
 - hh:mm[:ss] er klokkeslett 2 eller 3 ganger 2 siffer, adskilt med komma
 - ZZZ        er felt med tidssone informasjon

Dersom du ikke har benyttet headerfeltet 'X-Date', er datoen ovenfor
hentet fra mailsystemets medsendte dato. 

Forsøk å sende meldingen igjen med riktig tidsangivelse i headeren
X-Date. Dersom du har noe å spørre om, ta kontakt med $replyaddr.

Den opprinnelige meldingen er vedlagt nedenfor: 

----------
$body

");
    exit 0;
}



sub error {
    local($error) = $_[0];

    mailmsg("Artikkel kunne ikke sendes ut", "

Denne meldingen er automatisk generert. Du har sendt mail til adressen
for utsending av artikler - men meldingen kunne ikke sendes ut
på grunn av følgende feilsituasjon:

	$error

Ta kontakt med $replyaddr for evt. mer informasjon.

Den opprinnelige meldingen er vedlagt nedenfor:

----------
$body

");
    exit 0;
}



sub mailmsg {
    local($subj, $body) = @_;

    exit 0 unless $sender;	# exit silently if no recipeint

    open(MAIL, "| /usr/lib/sendmail -t") || exit 0;  
    print MAIL "To: $sender\n";
    print MAIL "Subject: $subj\n";
    print MAIL "Reply-to: $replyaddr\n";
    print MAIL "\n";
    print MAIL $body;
    close(MAIL);
}
