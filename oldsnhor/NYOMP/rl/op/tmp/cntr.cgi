$LOCK_SH = 1;
$LOCK_EX = 2;
$LOCK_NB = 4;
$LOCK_UN = 8;

sub lock {
  #pass in a file handle to be locked
  #flock will wait until it can get a lock

        flock($_[0], $LOCK_EX);
        # seek to whence just incase we were waiting for a lock after opening
        seek($_[0], 0, $_[1]);
}

sub unlock {
        flock($_[0], $LOCK_UN);
}
1; #return true        


