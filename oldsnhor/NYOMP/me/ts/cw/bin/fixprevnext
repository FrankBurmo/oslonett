#!/bin/sh

# Legger inn forrige og neste pekere i hver artikkel
#
# Filnavnet sendes inn som $1, men skriptet leser fra
# standard input.
#
# NB! B}de dette og andre skript forutsetter at filene
# heter cw<utgave><artikkelnr>.html.

PATH=/usr/bin:/bin:/local/bin:/usr/ucb

curart=`basename $1 .html | sed -e 's/^c.//g'`

# curart inneholder n} utgavenummeret, f.eks. 942701

# Skal s} finne ut andre tegn i filnavnet:

c=`echo $1 | cut -c2`

next=`expr $curart + 1`
prev=`expr $curart - 1`

dato=`date "+%d/%m-%y, kl. %H.%M"`

sed -e "s/xxx/c$c$prev/g" -e "s/yyy/c$c$next/g"  -e "s%zzz%$dato%g" 






