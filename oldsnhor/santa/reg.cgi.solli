#!/local/bin/perl5

require 5.001;
BEGIN {
   $DEBUG = 0;
   $psautil::TEST_NAMES = 1;
   if ($DEBUG) {
       $| = 1;
      print "Content-Type: text/plain\n\n";
   }
}


# Set up constant variables in 
#
# %response	response fields from reg server to netscape client
# @required	required fields in remote user input
init();

# Accept FORM input only
errorexit('illegaltype', $ENV{CONTENT_TYPE})
    unless $ENV{CONTENT_TYPE} eq 'application/x-www-form-urlencoded';

#errorexit('notsequre') unless $ENV{HTTPS} eq 'ON';


# First get FORM input
%input = getinput();

# We are using lock files. Use timeout to 1) give up if files are 
# unaccessible 2) release files if script is hanging
$SIG{'ALRM'} = \&timeout;
alarm $TIMEOUT;


# Make sure no other user is already registering
open(LOCK, ">$lock_file") || errorexit('failedopenlock');
flock(LOCK, $LOCK_EX) || errorexit('failedlock');
# process will sleep if file is already locked, only exit is via 'timeout'

# Write entry in log file "reg-attempt"
logfile($attempt_log);


# Verify that $input{RS_FORM_TYPE} eq "custinfo" and that all
# required fields are in accepted format.
assert(%input);


# Connect to PSA, send information, get user ID + password
@response{'LOGIN', 'PASSWORD'} = buildaccount(%input);


# Fill in EMAIL_ADDR, POP_SERVER and POP_PASSWORD elements in %response
$response{'EMAIL_ADDR'} = join('@', @response{'LOGIN','DOMAIN_NAME'});
$response{'POP_SERVER'} = join('@', @response{'LOGIN', 'SMTP_HOST'});
$response{'POP_PASSWORD'}= $response{'PASSWORD'};


# Write entry in log file "reg-success"
logfile($success_log);


# Return status
replysuccess(%response);


# finished - now let other users register
flock(LOCK, $LOCK_UN);
close LOCK || errorexit('failedcloselock');

exit 0;


sub buildaccount { 
    my(%input) = @_;
# %input contains all input fields from remote user. Relevant fields:
#
# CST_SERVICE       NEW | TEMP | OLD
# CST_FIRST_NAME
# CST_SECOND_NAME       ("mellomnavn")
# CST_LAST_NAME
# CST_FIRM
# CST_STREET_1
# CST_STREET_2
# CST_POSTAL_CODE
# CST_CITY		("poststed")
# CST_CC_TYPE		("betalingstype")
# CST_CC_EXPIRE
# CST_CC_NO

# In case an error (timeout?) occurs, call errorexit('error_type')

    $ENV{SYBASE} = "/home/frogner/www2/sybase";
    unshift(@INC, "/home/frogner/adm/psaII/lib");
    use Sybase::DBlib;
    require 'query.pl';
    require 'dbutil.pl';
    require 'psautil.pl';
    require 'log.pl';
    require 'reg.pl';

    Sybase::DBlib::dberrhandle(\&error);
    Sybase::DBlib::dbmsghandle(\&message);
    Sybase::DBlib::dbsettime(30);  # set timeout

    $db = Sybase::DBlib->dblogin('psaadm', 'goldfinger');

    my $mark_reg_nr = 0;
    # Check reg_nr/norm
    if($input{CST_SERVICE} eq "TEMP") {
        # Forhåndsbetalt konto
        errorexit('noregno') unless length($input{CST_REGNUMBER});
	my($reg_stat) = reg::check_reg_nr($db, $input{CST_REGNUMBER});
	errorexit('regno_unknown') if !$reg_stat;
	errorexit('regno_used')    if $reg_stat == 1;
	$mark_reg_nr = 1           if $reg_stat == 2;
    } elsif ($input{CST_SERVICE} eq "NEW") {
        # Spekulativ konto.

        # Kontoinformasjon må bare være oppgitt
        $input{CST_CC_NO} =~ s/\D//g;   # remove non-digits
        errorexit('badcc') if length($input{CST_CC_NO} < 11);
        # Vanlig bankkontonummer er 11 siffer.  Visa nr er 16 siffer.

	#normaliserings sjekk mot fornavn,enavn ...

    } else {
	errorexit('badservice');
    }

    # Find a password to use
    my($passord, $crypt) = psautil::genpass();
    errorexit('nopasswd')
	unless defined($passord) && defined($crypt);

    # Try to find a suitable username
    my $uname = psautil::suggest_username($db,
				 $input{CST_FIRST_NAME},
				 $input{CST_SECOND_NAME},
				 $input{CST_LAST_NAME},
				 $input{CST_FIRM},
				);

    # Uncomment the following line if you really want to update the database
    print "User: $uname\nPasswd: $passord\n"; return ($uname, $passord);
    errorexit('nousername') unless defined $uname;
    
    # Let's start to update the database
    dbutil::mark_transaction($db, "kunde");
    my $knr = query::get_new_knr($db);
    query::insert_abonnement($db, $knr, 1, 1);
    if (query::insert_uname($db, $knr, $uname) < 0) {
	dbutil::rollback($db, "kunde");
	errorexit('failedinsert');
    }
    dbutil::commit($db, "kunde");

    query::insert_nnavn_from_knr($db, $knr,
				 $input{CST_FIRST_NAME},
                                 $input{CST_SECOND_NAME},
                                 $input{CST_LAST_NAME});
    query::insert_adress($db, $knr,
			 $input{CST_FIRM},
			 $input{CST_STREET_1},
			 $input{CST_STREET_2},
			 $input{CST_POSTAL_CODE},
			 $input{CST_CITY});
    query::insert_tlf($db, $knr,	
		      $input{CST_PRIVAT_PHONE},
		      $input{CST_WORK_PHONE},
		      $input{CST_FAX});
    query::insert_debet_info($db, $knr,
			     $input{CST_CC_TYPE},
			     $input{CST_CC_NO},
			     $input{CST_CC_EXPIRE});

    query::update_passwd_knr($db, $knr, $crypt);
    reg::mark_reg_nr($db,$knr,$input{CST_REGNUMBER}) if $mark_reg_nr;

    # return created user name and password in an array:
    return ($uname, $passord);
}


sub error
{
    my($db, $severity, $dberr, $oserr, $dbmsg, $osmsg) = @_;
    errorexit('dberr', $dberr, $dbmsg);
    INT_EXIT;
}

sub message
{
    my($db, $no, $state, $severity, $text, $server, $proc, $line) = @_;
    return if $no == 5701 || $no == 5703;
    open(DBLOG, ">>$dbmess_log") or return;
    print DBLOG scalar(localtime) . " #$no $state $severity $text\n";
    close(DBLOG);
}



sub assert { 
    my(%input) = @_;
    errorexit('illegalformtype')
	unless $input{RS_FORM_TYPE} eq "custinfo";
    while ( ($key, $val) = each %input ) {
	# Field is not mandatory if not in keys(%required)
	next unless defined $required{$key};

	# Free form (but not null) if $required{$key} is defined && 0 length
	next if length $required{$key} == 0 && $val =~ /\S/;

	# Otherwise $val must match perl regexp in $required{$key}
	next if $val =~ /$required{$key}/;

	errorexit('missinginput', $key, $val);
    }
}


sub logfile {
    my $filename = shift;
# Appends a line to the specified log file.  Format :
#      <name>=<value><TAB>...<name>=<value><EOL>
# First name/value is CST_DATE_CREATED, other fields in any sequence

    open(LOG, ">>$filename") || errorexit('failedopenlog', $filename);

    @t = localtime(time);
    $t[4]++;
    $t[5] -= 1900 if $t[5] > 1900;
    $date = sprintf("%02d:%02d:%02d.%06d %02d:%02d:%02d",
		    @t[2,1,0], 0, @t[3,4,5]);

    logwrite("CST_DATE_CREATED=$date");

    while ( ($key, $val) = each %input) {
	$val = "(not defined)" unless length $val;
	logwrite("\t$key=$val");
    }

    if (length $response{'LOGIN'}) {
	# %response fields are only meaningful to log after successful account creation
	logwrite("\tCST_EMAIL_ADDRESS=$response{'EMAIL_ADDR'}");

	foreach ('LOGIN', 'ISP_SUPPORT', 'ISP_URL', 'PHONE_NUM') {
	    logwrite("\t$_=$response{$_}");
	}
    }
    logwrite("\n");

    close LOG || errorexit('failedcloselog');
}


sub logwrite {
    # write a line to LOG, exit if syswrite failed. Will exit if disk is full.
    ($text) = $_[0];
    syswrite LOG, $text, length $text
      || errorexit('failedwritelog');
}


sub replysuccess {
    if ($DEBUG) {
	#print "<table>\n";
	while ( ($key, $val) = each %response) {
	    #print "<tr><td>$key<td>$val</tr>\n";
	    print "$key = $val\n";
	}
	#print "</table>\n";
	return;
    }

    print $content_type;
    sendfield("STATUS","OK");
    sendfield("REGSTATUS","OK");

    while ( ($key, $val) = each %response) {
	sendfield($key, $val);
    }
}


sub errorexit {
    # return error message to remote client + log message to error file

    # first release possible file lock
    flock(LOCK, $LOCK_UN);
    close LOCK;

    local($type, $x, $y) = @_;
    $msg = $error{$type} || "UNSPECIFIED/$type";
    $msg =~ s/XXXX/$x/g;
    $msg =~ s/YYYY/$y/g;

    if ($DEBUG) {
	print "ERROR $msg\n";
	exit;
    }
    print $content_type;
    sendfield("STATUS", "OK");
    sendfield("REGSTATUS", "ERROR: $msg");

    if (open(ERR, ">>$error_log")) {
	@t = localtime(time);
	$t[4]++;
	$t[5] -= 1900 if $t[5] > 1900;
	$date = sprintf("%02d:%02d:%02d.%06d %02d:%02d:%02d",
			@t[2,1,0], 0, @t[3,4,5]);
	print ERR "$date: $msg\n";
	close ERR;
    }
    exit 1;
}


sub sendfield {
    ($key, $val) = @_[0,1];
    print pack("S", length $key), $key;
    print pack("S", length $val), $val;
}



sub init {
    $content_type = "Content-Type: application/x-netscape-autoconfigure-dialer\n\n";

    my $PREFIX = "/local/www/aksess";
    my $PREFIX = "/home/frogner/www/santa"; # While we still run on Frogner

    $attempt_log = "$PREFIX/logs/reg-attempt";
    $success_log = "$PREFIX/logs/reg-success";
    $dbmess_log  = "$PREFIX/logs/db-mess";
    $error_log   = "$PREFIX/logs/reg-error";
    $lock_file   = "$PREFIX/logs/lock_file";

    $LOCK_EX = 2;             # Exclusive file lock
    $LOCK_UN = 8;             # Release file lock
    $TIMEOUT = 60;            # Maximum life time of script, in seconds


    %response = (
		 # mandatory fields
		 'SITE_FILE',	'sn',		# Client file name
		 'SITE_NAME',	'SN Internett',	        # Client Textual ID for ISP
		 'LOGIN',	'',			# To be filled in automatically
		 'PASSWORD',	'',			# To be filled in automatically
		 'PHONE_NUM',	'22608080',		# PPP modem, Oslo
		 'DNS_ADDR',	'194.143.8.27',		# frogner.oslonett.no
		 'DNS_ADDR_2',	'194.143.8.25',		# hasle.oslonett.no
		 'NNTP_HOST',	'news.oslonett.no',	# CNAME=hasle.oslonett.no
		 'SMTP_HOST',	'mail.oslonett.no',	# CNAME=hasle.oslonett.no
		 'DOMAIN_NAME',	'oslonett.no',
		 'POP_SERVER',	'',			# To be filled in automatically
		 'POP_PASSWORD','',			# To be filled in automatically
		 'EMAIL_ADDR',	'',			# To be filled in automatically
		 #optional fields
#		 'ISP_DESC',	'',			# long description
#		 'ICON',	'',			# 32x32 pixel windows ICO logo
		 'ISP_SUPPORT',	'22020110',		# CHECK THIS.
		 'ISP_URL',	'http://aksess-www.oslonett.no/', # eller www.oslonett.no?
		 );

    # Format of %required: required name = perl regexp or '' (implying free from)
    %required = (
#		 'CST_STREET_1',	'',
#		 'CST_POSTAL_CODE',	'\d{4}',
#		 'CST_CITY',		'',
#		 'CST_CC_NO',	'',
#		 'CST_CC_TYPE',	'',
#		 'CST_CC_MTH_EXPIRE','^(0[1-9]|1[012])$',
#	         'CST_CC_YEAR_EXPIRE','^\d\d$',
#		 'CST_CC_CARDHOLDER','',
		 );

    %error = (
	      "illegaltype",    "Illegal content-type sent to reg server: XXXX",
	      "illegalmethod",  "Illegal request metod sent to reg server: XXXX",
	      "notsequre",      "Not sequre server",
	      "failedopenlock", "Failed to open lock file",
	      "failedlock",     "Failed to lock lock file",
	      "failedcloselock","Failed to close lock file",
	      "nopasswd",       "Can't find a passwd",
	      "nousername",     "Can't find a user name",
	      "failedinsert",   "Insert into uname failed",
	      "dberr",          "DB-ERR-XXXX: YYYY",
	      "illegalformtype","Illegal FORM_TYPE",
	      "missinginput",   "Missing (or illegally formatted) input: XXXX=YYYY",
	      "failedopenlog",  "Failed to open log file XXXX",
	      "failedwritelog", "Failed to write to log file XXXX (disk full?)",
	      "failedcloselog", "Failed to close log file XXXX",
	      "timeout",        "Timeout - giving up file lock",
	      "regno_unknown",	"Registeringsnummeret eksisterer ikke",
	      "regno_used",	"Registeringsnummeret er i bruk",
              "noregno",        "Registeringsnummeret mangler",
              "badcc",          "Feil ved kontoinformasjon",
	      "badservice",     "Illegal CST_SERVICE",
	      );

}



sub getinput {
# Return %input array, associating input names with input values.
    local($i, $name, $value, $data, @data, %input);

    if ($ENV{'REQUEST_METHOD'} eq "GET") {
        $data = $ENV{'QUERY_STRING'};
    } elsif ($ENV{'REQUEST_METHOD'} eq "POST") {
        $bytes_to_read = $ENV{'CONTENT_LENGTH'};
        while ($bytes_to_read > 0) {
	    $n = read(STDIN, $data, $bytes_to_read, length $data);
	    $bytes_to_read -= $n;
	}
    } else {
	errorexit('illegalmethod', $ENV{'REQUEST_METHOD'});
    }

    # '&' is FORM input field separator
    @data = split(/&/, $data);

    for $i (0 .. $#data) {

        # Spaces in FORM input is coded as +. Decode:
        $data[$i] =~ tr/+/ /;

        # Anything to the left of the first '=' is field name, the rest is field value
        ($name, $value) = split(/=/, $data[$i], 2);

	# Replace %<hexcode> with corresponding character
        $name =~ s/%(..)/pack("c",hex($1))/ge;
        $value =~ s/%(..)/pack("c",hex($1))/ge;

	# "\t" is the log file separator. Make _sure_ log files are consistent
        $name =~ s/\t/ /g;
        $value =~ s/\t/ /g;

        $input{$name} = $value;
    }
    return %input;
}


sub timeout {
    # this subroutine is called after fixed amount of time because 
    # 1) cannot lock lock file or 2) unknown reason
    # must unlock lock file to let other users register

    flock(LOCK, $LOCK_UN);
    close LOCK;
    errorexit('timeout');
}
