#!/bin/sh -e

#  Dette skriptet oversetter alle RTF filer i cur-dir til HTML.
#  NB! Map-filen html-trans m} ligge i cur-dir eller pekes ut av
#  en envir variabel.

HOME=/home/frogner/a/kgn
PATH=$HOME/cw/bin:/usr/bin:/bin:/local/bin:/usr/ucb
RTFLIBDIR=$HOME/cw/lib
export PATH
TMP=$$.tmp

if ( test ! -f ansi-gen ) then ln -s /local/lib/rtf-tools/ansi-gen
fi
if ( test ! -f ansi-sym ) then ln -s /local/lib/rtf-tools/ansi-sym
fi
if ( test ! -f html-map ) then ln -s /local/lib/rtf-tools/html-map
fi
if ( test ! -f html-trans ) then ln -s $HOME/cw/lib/html-trans html-trans
fi
if ( test ! -f rtf-ctrl ) then ln -s /local/lib/rtf-tools/rtf-ctrl
fi

## Fix først "hull" i RTF filsekvensen :

holefix

for x in *.rtf
do
  echo Translating $x to HTML ..
  cwrtftohtml -T $x
  echo $x done
done
