\par }\pard \sl-400\slmult0\keep {\b\fs40 En  \ldblquote alt i ett-konto\rdblquote  som gj\'f8r det enkelt for deg!
\par 
\par }\pard \sl-320\slmult0\keep {\fs32 BN-konto er v\'e5rt tilbud til bankkunder som er lei av \'e5 sjonglere med forskjellige konti og rentesatser. En alt i ett-konto som h\'e5
ndterer de vanligste banktjenester - og som samtidig gir topp rente. Enkelt, oversiktlig og uten irriterende begrensninger i bruken.
\par }\pard \sl-320\slmult0\keep {\fs32 
\par }{\b\fs32 L\'f8nnsom l\'f8nnskonto}{\fs32 
\par }\pard \sl-320\slmult0\keep {\fs32 
\par }\pard \sl-320\slmult0\keep {\fs32 BNkonto bruker du akkurat som du er vant til \'e5 benytte din  l\'f8nnskonto. L\'f8nn og andre innbetalinger g\'e5r rett inn p\'e5 din BNkonto. Det er ingen begrensninger p\'e5 antall uttak eller overf\'f8ringer pr. \'e5
r. Og med BNkort, v\'e5rt nye uttaks- og betalingskort, har du tilgang til pengene dine 24 timer i d\'f8gnet.
\par }\pard \sl-320\slmult0\keep {\fs32 
\par }{\b\fs32 Full kontroll over faste utgifter}{\fs32 
\par 
\par }\pard \sl-320\slmult0\keep {\fs32 BNkonto fungerer ogs\'e5 som budsjettkonto. Penger kan settes av til dekning av faste utgifter (boligl\'e5n, forsikringer, str\'f8mregninger etc.). Betales ved hjelp av autogiro/brevgiro.
\par }\pard \sl-320\slmult0\keep {\fs32 
\par }{\b\fs32 Sparekonto med h\'f8yrente
\par }{\fs32 
\par }\pard \sl-320\slmult0\keep {\fs32 BNkonto gir h\'f8yrente fra f\'f8rste krone - n\'e5r innskuddet er 25.000 kroner eller mer. Kommer saldoen under 25.000 kroner, reduseres renten til 1 %. Har du flere konti, blir rente selvf\'f8lgelig beregnet p\'e5
 grunnlag av totalsummen du har innest\'e5ende. Er summen over 25.000 kroner p\'e5 alle konti, f\'e5r du h\'f8yeste rente.
\par }\pard \sl-240\slmult0\keep {\fs32 \page }{\fs28 
\par }\pard \sl-560\slmult0\keep {\fs56 Innskuddsbetingelser BNkonto
\par }\pard \sl-240\slmult0\keep {\fs56 
\par }\pard \sl-280\slmult0\keep {\fs28 Rentebetingelser
\par }\pard \sl-280\slmult0\keep {\fs28 innskudd under         kr. 25.000,- : 1,0  % p.a.
\par innskudd fra og med kr. 25.000,- : 5,25% p.a.*
\par 
\par }\pard \sl-280\slmult0\keep {\fs28 *) H\'f8yeste rentesats fra f\'f8rste krone. Gjelder for innskudd inntil 10 mill. pr. kunde. For h\'f8yere bel\'f8p, kontakt banken.   
\par }\pard \sl-280\slmult0\keep {\fs28 
\par }\pard \sl-280\slmult0\keep {\fs28 Renten begrenses etterskuddsvis og legges til kapitalen ved \'e5rets slutt. Ingen begrensninger i antall uttak eller overf\'f8ringer pr. \'e5r.
\par }\pard \sl-280\slmult0\keep {\fs28 Ingen uttaksprovisjon. Ved overtrekk beregnes 18% rente p.a.
\par }{\b\fs36 
\par Kontobruk
\par }{\fs28 Brevgiro, pr. giro\tab \tab \tab \tab \tab kr.  5,-*)  (+porto pr. sending)
