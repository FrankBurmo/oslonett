\par }\pard \sl-400\slmult0\keep {\fs40 Bolig- og N\'e6ringsbanken AS (BNbank) kan f\'f8re sin historie tilbake til 1961 og har operert under tre forskjellige navn; AS N\'e6ringskreditt, Bolig- og N\'e6ringskreditt AS og Bolig- og N\'e6ring
sbanken AS. Selskapet ble omdannet fra kredittforetak til bank i 1992.
\par }\pard \sl-400\slmult0\keep {\fs40 
\par }\pard \sl-400\slmult0\keep {\fs40 BNbank er landets fjerde st\'f8rste forretningsbank med en forvaltningskapital p\'e5 kr 24 milliarder kroner og har i alle \'e5r g\'e5tt med overskudd. Bankens aksjer er notert p\'e5 Oslo B\'f8
rs. Egenkapitalen var kr 1,9 milliarder pr. 31.12.1994. 
\par }\pard \sl-400\slmult0\keep {\fs40 
\par }\pard \sl-400\slmult0\keep {\fs40 Banken er en spesialbank som tilbyr pantel\'e5n til n\'e6ringsliv, boliger og offentlig virksomhet. 
\par }\pard \sl-400\slmult0\keep {\fs40 
\par }\pard \sl-400\slmult0\keep {\fs40 Utl\'e5nsmidlene kommer fra innskudd og utstedelse av obligasjoner og sertifikater.
\par }\pard \sl-400\slmult0\keep {\fs40 
\par }\pard \sl-400\slmult0\keep {\fs40 BNbank tilbyr konkurransemessige vilk\'e5r basert p\'e5 kostnadseffektiv drift og et begrenset antall produkter og tjenester.
\par }\pard \sl-400\slmult0\keep {\fs40 
\par }\pard \sl-400\slmult0\keep {\fs40 Banken har hovedkontor i Trondheim og avdelings-kontor i Oslo.
\par {\pntext\tab}}\pard \fi-283\sl-400\slmult0\keep{\*\pn \pnlvlcont\pnf1\pnstart1\pnindent283\pnhang{\pntxtb \'b7}}{\fs40 
