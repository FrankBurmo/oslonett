\par {\pntext\pard\plain\b\f1\fs28 \'b7\tab}}\pard \fi-283\li283{\*\pn \pnlvlblt\pnf1\pnstart1\pnindent283\pnhang{\pntxtb \'b7}}{\b\fs28 Hjem&Data'95
