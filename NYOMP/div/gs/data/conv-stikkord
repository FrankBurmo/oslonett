#!/local/bin/perl5 -w

use POSIX;
setlocale(LC_CTYPE, "iso_8859_1");

open(F, "./conv stikkord.tab |") or die;

%seen = ();
while (<F>) {
   chomp;
   ($no, $ord) = split("\t", $_);
   unless ($no =~ /^\d+$/) {
       warn "Illegal number: $_\n";
       next;
   }
   if ($seen{$no}++) {
       warn "Duplicate number: $_\n";
       next;
   }
   $ord = lc $ord;
   print "$no\t$ord\n";
}
