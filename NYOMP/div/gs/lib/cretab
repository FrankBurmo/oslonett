#!/local/bin/perl5 -w

# $Id: cretab,v 1.3 1996/01/19 15:35:52 aas Exp $
#
# Create SQL tables and indexes.
#
# Gisle Aas, Oslonett AS
#

use Getopt::Std;

unless (getopts("iId")) {
    $0 =~ s,.*/,,;
    die <<"USAGE";
Usage: $0 [-iId] [table]...
  -d    only drop
  -i    index together with tables
  -I    index only
If you don't specify a table then it will pick all *.tab files in the
current directory.
USAGE
}
$opt_i = 1 if $opt_I;

use lib '/local/www/div/gs/lib';

require SQL::Table;
require SQL::TableDep;

if (@ARGV) {
    @tables = @ARGV;
    for (@tables) {
	s/\.tab$//;
    }
} else {
    opendir(D, ".");
    @files = readdir(D);
    closedir(D);
    @tables = grep(s/\.tab$//, @files);
}

# Sort tables based on dependencies.
@tables = SQL::TableDep::sort_tables(@tables);

# Make real table objects
for $tab (@tables) {
    $tab = new SQL::Table $tab;
}

# Drop indexes
if ($opt_i) {
    for $tab (@tables) {
	$sql = $tab->sql_drop_index;
	print $sql  . "go\n" if length $sql;
    }
}

unless ($opt_I) {
    # First we drop all tables in reverse sequence, then we create them.
    for $tab (reverse @tables) { print $tab->sql_drop;   print "go\n"; }
    unless ($opt_d) {
	for $tab (@tables) { print $tab->sql_create; print "go\n"; }
    }
}

# Create indexes
if ($opt_i && !$opt_d) {
    for $tab (@tables) {
	$sql = $tab->sql_create_index;
	print $sql  . "go\n" if length $sql;
    }
}
