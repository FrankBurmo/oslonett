#!/bin/sh
# 
###
#
# Dette skriptet bygger opp en artikkelindeks for en spesiell utgave
# av CW. Forutsetter at alle .html filene ligger p} plass i det
# riktige directoriet og at de heter cw<utgave><artikkelnr>.html,
# der f.eks <utgave> = 9427 og <artikkelnr> = 00,01 osv.
#
# Kalles slik:
#
#   % mkartindex <utgave> <title tekst for indeksen>
#
# f.eks (legg merke til fnuttene!)
#
# bin/mkartindex 9429 "29, 2. september 1994"

PATH=/home/stovner/a/kgn/bin:/usr/bin:/bin:/local/bin:/usr/ucb
# TMP fil for mellomlagring
TMP=$$.tmp
# Path fram til utgave directoriet
CUR=/local/www/me/ts/cw/utg/current.html
CW=/local/www/me/ts/cw/utg/$1
# Path sett fra WWW serveren
CWWWW=/me/ts/cw/utg/$1

WAISINDEX=/local/bin/waisindex
WWW=/local/www
HTTP=http://www.oslonett.no

##
## WAIS srces
##


CWSRC=/local/www/wais/CW95

# Hva skal indeksen hete
ARTINDEX=art-index.html
# Navn p} header og footer for indeksen
ARTINDHEADER=/home/stovner/a/kgn/cw/lib/artheader
ARTINDFOOTER=/home/stovner/a/kgn/cw/lib/artfooter

# Skriv ut header og substituer inn riktig <title>

(
cat $ARTINDHEADER | sed -e "s/xxx/$2/g"

# Ta vare p} current dir, g} til omr}de for denne utgaven og start
# generering av <ul> indeks

echo "<ul>"
# Alle filene antas } hete c?*.html
for x in c?*.html
do
# pakk ut <title>, det brukes som linktekst:
   hlp=`grep '<title>' $x | head -1`
   tit=`echo $hlp | sed -e 's/<title>//g' -e 's%</title>%%g'`
# lag linken
   echo "<li> <a href=$CWWWW/$x>$tit</a>"
done
echo "</ul>"

# Ferdig, skriv ut footer, men sett in dato og klokkeslett
dato=`date "+%d/%m-%y, kl. %H.%M"`

cat $ARTINDFOOTER | sed -e "s%xxx%$dato%g"  -e "s%yyy%$1%g"
) > $TMP
mv $TMP $ARTINDEX

echo "Artikkelindeks for CW utgave $1 ferdig. Starter WAIS indeksering i background .."




 